# Copy to .env and fill in values. Never commit .env or API keys.

# OpenRouter (for API-backed models and gold-standard classification)
OPENROUTER_API_KEY=

# Hugging Face Hub (gated models / higher rate limits)
HF_TOKEN=

# Optional: keep Hub caches inside the repo if ~/.cache is not writable
# HF_HOME=/path/to/scale-c-benchmarking/.cache/huggingface
# HF_HUB_CACHE=/path/to/scale-c-benchmarking/.cache/huggingface/hub
